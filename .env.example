# Embedding backend: fake | sentence-transformers | openai | groq | ollama
EMBEDDING_BACKEND=fake

# OpenAI-compatible settings (used when EMBEDDING_BACKEND=openai or groq)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq (OpenAI-compatible chat; embeddings still often via OpenAI/local)
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

CHROMA_PERSIST_DIR=./data/chroma
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
